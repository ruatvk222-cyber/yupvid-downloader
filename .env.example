# Copy to .env and fill in (or use `yupvid-dl login` to store in your OS keyring).
# Do NOT commit .env.

YUPVID_EMAIL=
YUPVID_PASSWORD=

# Optional: path to a Netscape-format cookies.txt file exported from your browser.
# When set, takes precedence over email/password and skips the login step.
# YUPVID_COOKIES_FILE=./cookies.txt

# Optional: override base URL (almost never needed).
# YUPVID_BASE_URL=https://yupvid.com

# Optional: where to store downloaded MP4s. Default: ./videos
# YUPVID_OUTPUT_DIR=./videos

# Optional: concurrent downloads. Default: 3
# YUPVID_CONCURRENCY=3
